# Auto detect text files and perform LF normalization
* text=auto

# Java sources
*.java text diff=java
*.gradle text
*.properties text

# Build output
*.class binary
*.jar binary

# Shell scripts
*.sh text eol=lf
gradlew text eol=lf

# Windows scripts
*.bat text eol=crlf
*.cmd text eol=crlf
gradlew.bat text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.gif binary
*.ico binary

# Gradle wrapper
gradle/wrapper/gradle-wrapper.jar binary
