#!/usr/bin/env bash
# Wrapper around the locally built Gnomish Factory jar (gnomish.jar).
#
# Adds two things every invocation from this project needs, then passes the rest through:
#   --dir=<this project, absolute>   (a relative --dir breaks law-file resolution)
#   --factory.instance-name=<project>        (this clone's name; see below)
#   --factory.bindings.default-binding=host  (no sandbox image is built for this project yet)
#   --factory.agent-cli-binary=<claude-gnome>       (adds --permission-mode acceptEdits; see that script)
#   --factory.sandbox.env-passthrough=GH_TOKEN      (the deliver stage needs `gh`; see the token block)
#
# Both are plain defaults: pass your own --dir=... or --factory.bindings.default-binding=container
# and yours wins (last flag on the Spring command line takes precedence).
#
# Secrets use the factory's own file indirection (EnvFileSecretsProvider): for a secret N it
# reads N_FILE as a path and takes the file's contents, so the token itself never enters this
# process's environment table. All this script does is point N_FILE at the local file. The
# files live OUTSIDE the clone — with binding=host the gnome runs in this working tree, and a
# token in the tree is one it can read and one you can commit — and they are per project:
# ~/.gnomish/secrets/<project>, keyed by this clone's directory name, the same way the factory
# keys ~/.gnomish/worktrees/<project>. One token per project, revocable on its own.
#
#   mkdir -p ~/.gnomish/secrets/gf-tests
#   install -m 600 /dev/null ~/.gnomish/secrets/gf-tests/github-token
#   # paste the token in, no quotes and no KEY= prefix — the file IS the value
#
# GNOMISH_SECRETS_DIR moves the directory; GNOMISH_GITHUB_TOKEN_FILE names one file directly;
# an already-exported GNOMISH_GITHUB_TOKEN still works and is left alone.
#
# The log file is keyed by project the same way: ~/.gnomish/logs/<project>/gnomish.log.
# GNOMISH_LOG_DIR still wins if you set it yourself.
#
# --factory.instance-name does the same for the daemon's own state: serve publishes
# snapshot.json and its daily ledgers under ~/.gnomish/serve/<instance-name>/, and
# `dashboard` reads that same path. Two daemons sharing one name is a documented
# misconfiguration — they overwrite each other's snapshot, so both dashboards show
# whichever wrote last, and their ledgers interleave. The clone name keeps them apart
# and puts the project into the claim comments the gnome leaves on the tracker
# (<project>-<random suffix>). The suffix is minted per process anyway, so nothing
# downstream depends on the name staying what it was.
#
#   ./gnomish run --task="..." --mode=in-place --interactive
#   ./gnomish status --task=<id>
set -euo pipefail

project_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Keyed by the clone directory's own name, exactly as the factory keys its worktrees root
# (operator-guide-run.md: ~/.gnomish/worktrees/<project-name>/...), so two clones served by
# one factory never share a token by accident.
secrets_dir="${GNOMISH_SECRETS_DIR:-$HOME/.gnomish/secrets/$(basename "$project_dir")}"

# The factory's own default is one log file per host, so two factories started from two
# clones interleave their narratives into a single gnomish.log and neither one can be read
# on its own. Keying the directory by clone name gives each its own file to tail. Exported,
# not passed as a flag: logback reads it from the environment before Spring starts.
export GNOMISH_LOG_DIR="${GNOMISH_LOG_DIR:-$HOME/.gnomish/logs/$(basename "$project_dir")}"

# Point <SECRET>_FILE at the local file, but only when that file is actually there: the
# provider is fail-closed, so a _FILE naming a missing path resolves the secret as ABSENT
# instead of falling back to the plain variable — pointing it at nothing would break an
# operator who exports the token the old way.
point_at_file() {
    local var="$1" file="$2"
    [[ -f "$file" ]] || return 0
    if [[ -n "${!var:-}" ]]; then
        return 0  # an explicit path from the caller wins over the convention
    fi
    local perms
    perms="$(stat -f %Lp "$file" 2>/dev/null || stat -c %a "$file" 2>/dev/null || echo "600")"
    if [[ "${perms: -2}" != "00" ]]; then
        echo "gnomish: $file is mode $perms — it holds a token, run: chmod 600 $file" >&2
    fi
    export "$var=$file"
}

point_at_file GNOMISH_GITHUB_TOKEN_FILE "$secrets_dir/github-token"
point_at_file GNOMISH_GITHUB_ACTIONS_TOKEN_FILE "$secrets_dir/github-actions-token"

# The deliver stage runs `gh` — in the gnome's round and in that stage's own command checks —
# and `gh` takes its credential from GH_TOKEN. The tracker's GNOMISH_GITHUB_TOKEN cannot serve
# it: the factory declares that name a credential, so it is scrubbed from every child
# environment and refused in the passthrough allowlist by construction. The same token is
# therefore exported a second time under a name the factory has no reason to treat as one, and
# allowlisted by name below.
#
# What that costs, plainly: the gnome's process holds a token with the tracker's own rights —
# it can write issues and labels as you, and the value now sits in this process's environment
# table, which the *_FILE indirection above exists to avoid. Dropping a fine-grained token
# scoped to Contents + Pull requests into github-pr-token narrows both: it wins over the
# tracker token here, and nothing else reads it.
pr_token_file="$secrets_dir/github-pr-token"
[[ -f "$pr_token_file" ]] || pr_token_file="$secrets_dir/github-token"
if [[ -z "${GH_TOKEN:-}" && -f "$pr_token_file" ]]; then
    GH_TOKEN="$(tr -d '[:space:]' < "$pr_token_file")"
    export GH_TOKEN
fi

# Only a default: a repeated Spring option is joined with a comma rather than overridden by
# the last one, so an explicit --factory.instance-name from the caller replaces this instead
# of competing with it.
instance_name=(--factory.instance-name="$(basename "$project_dir")")
for arg in "$@"; do
    case "$arg" in
        --factory.instance-name=*) instance_name=() ;;
    esac
done

if [[ -z "${GNOMISH_GITHUB_TOKEN_FILE:-}" && -z "${GNOMISH_GITHUB_TOKEN:-}" \
      && "${1:-}" != "--help" && "${1:-}" != "-h" ]]; then
    echo "gnomish: no $secrets_dir/github-token and no GNOMISH_GITHUB_TOKEN — tracker calls will fail" >&2
fi

exec java -jar "$project_dir/gnomish.jar" \
    --dir="$project_dir" \
    ${instance_name[@]+"${instance_name[@]}"} \
    --factory.bindings.default-binding=host \
    --factory.agent-cli-binary="$project_dir/claude-gnome" \
    --factory.sandbox.env-passthrough=GH_TOKEN \
    "$@"
