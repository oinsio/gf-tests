#!/usr/bin/env bash
# Wrapper around the locally built Gnomish Factory jar (gnomish.jar).
#
# Adds two things every invocation from this project needs, then passes the rest through:
#   --dir=<this project, absolute>   (a relative --dir breaks law-file resolution)
#   --factory.bindings.default-binding=host  (no sandbox image is built for this project yet)
#   --factory.agent-cli-binary=<claude-gnome>       (adds --permission-mode acceptEdits; see that script)
#
# Both are plain defaults: pass your own --dir=... or --factory.bindings.default-binding=container
# and yours wins (last flag on the Spring command line takes precedence).
#
#   ./gnomish run --task="..." --mode=in-place --interactive
#   ./gnomish status --task=<id>
set -euo pipefail

project_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

exec java -jar "$project_dir/gnomish.jar" \
    --dir="$project_dir" \
    --factory.bindings.default-binding=host \
    --factory.agent-cli-binary="$project_dir/claude-gnome" \
    "$@"
