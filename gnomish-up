#!/usr/bin/env bash
# Starts the factory daemon and its dashboard with one command.
#
# Equivalent to running these three side by side, in three terminals:
#   ./gnomish dashboard --watch --out=logs/dashboard.html
#   tail -F ~/.gnomish/logs/<project>/gnomish.log
#   ./gnomish serve --slots=1
#
# The dashboard renderer and the log follower go to the background, the daemon stays
# in the foreground, so its output is what you see and Ctrl-C stops all three — the
# daemon drains its in-flight slots the same way it does on its own, then the other
# two are torn down with it.
#
# The log follower is there because the daemon's console carries only WARN and above:
# the INFO narrative — what each gnome is doing, stage by stage — only ever reaches
# the log file. Without it a healthy run looks like a silent terminal. The file is
# ~/.gnomish/logs/<project>/gnomish.log — per clone, so two factories running side by
# side keep two separate narratives instead of interleaving into one.
#
#   ./gnomish-up                 # 1 slot, opens the dashboard in a browser
#   ./gnomish-up --slots=4       # any serve flag is passed straight through
#   ./gnomish-up --drain --no-open --no-logs
#   ./gnomish-up --demo          # recording mode: see below
#   ./gnomish-up --demo --port=5500
#
# --no-open (skip the browser), --no-logs (skip the log follower), --demo and --port are
# this script's own flags; everything else belongs to `gnomish serve`. --slots=1 is only a
# default: pass your own and yours is used.
#
# --demo is for a screen recording, and does two things. It rewrites what this terminal
# prints — this clone's path becomes `.`, the rest of the home directory becomes `~` — so
# nothing on screen carries the username or the folder layout above the project. The log
# file keeps its absolute paths, so debugging afterwards is unaffected; the rewrite covers
# this script's own messages, the followed log and the daemon's console alike.
#
# And it serves the dashboard over http instead of handing the browser a file:// path, so
# the address bar reads http://localhost:8000 rather than the full path to this clone. The
# server is python3's, bound to loopback (it exposes the whole logs/ directory, which has no
# business leaving this machine), and --port moves it. With no --port and the default
# taken, a busy port is stepped over rather than fatal — two factories can record at once.
set -euo pipefail

project_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
dashboard_out="${GNOMISH_DASHBOARD_OUT:-$project_dir/logs/dashboard.html}"
dashboard_log="${GNOMISH_DASHBOARD_LOG:-$project_dir/logs/dashboard-render.log}"
# Resolved here and exported, so the follower and the daemon it starts cannot end up on
# two different files: the wrapper defaults this the same way, and an already-set value
# (yours, or this one) is left alone by it.
export GNOMISH_LOG_DIR="${GNOMISH_LOG_DIR:-$HOME/.gnomish/logs/$(basename "$project_dir")}"
factory_log="$GNOMISH_LOG_DIR/gnomish.log"

open_browser=1
follow_logs=1
demo_mode=0
dashboard_port="${GNOMISH_DASHBOARD_PORT:-8000}"
port_explicit=0
if [[ -n "${GNOMISH_DASHBOARD_PORT:-}" ]]; then
    port_explicit=1
fi
serve_args=()
for arg in "$@"; do
    case "$arg" in
        --no-open) open_browser=0 ;;
        --no-logs) follow_logs=0 ;;
        --demo) demo_mode=1 ;;
        --port=*) dashboard_port="${arg#--port=}"; port_explicit=1 ;;
        *) serve_args+=("$arg") ;;
    esac
done

# A port someone named is the port they want: say so rather than quietly landing elsewhere.
# The default is ours to move, and moving it is what lets a second factory record alongside
# the first instead of failing to bind.
if [[ $port_explicit -eq 1 ]]; then
    port_candidates=("$dashboard_port")
else
    port_candidates=($(seq "$dashboard_port" $((dashboard_port + 9))))
fi

# Served over http the page is the directory index, so the address bar carries no file name
# at all — the point of serving it. Only the default moves; an explicit GNOMISH_DASHBOARD_OUT
# stays where the operator put it.
if [[ $demo_mode -eq 1 && -z "${GNOMISH_DASHBOARD_OUT:-}" ]]; then
    dashboard_out="$project_dir/logs/index.html"
fi
http_log="${GNOMISH_DASHBOARD_HTTP_LOG:-$project_dir/logs/dashboard-http.log}"

# Everything this terminal shows goes through one rewrite, so the daemon's own console and
# the followed log are covered by the same rule as the messages below — and nothing has to
# remember to opt in. The file on disk is untouched: after the recording, the absolute paths
# are still there to debug with.
if [[ $demo_mode -eq 1 ]]; then
    # -l on BSD sed, -u on GNU: line buffering. Without it an idle daemon's output would sit
    # in a 4KB block buffer, and a demo would be watching a terminal that says nothing.
    if sed -l '' </dev/null >/dev/null 2>&1; then
        redact=(sed -l)
    else
        redact=(sed -u)
    fi
    # Substitute a path prefix only where the path actually ends, or a sibling clone whose
    # name starts with this one's — gf-tests-demo next to gf-tests — comes out as `.-demo`.
    # The clone first, the home directory second: the clone lives inside the home directory,
    # so rewriting the home directory first would leave the longer path unmatched.
    boundary_sub() { printf '%s' "s|$1\\([^-A-Za-z0-9_.]\\)|$2\\1|g;s|$1\$|$2|g"; }
    redact+=(-e "$(boundary_sub "$project_dir" .)" -e "$(boundary_sub "$HOME" '~')")
    exec > >("${redact[@]}") 2> >("${redact[@]}" >&2)
fi

# `--slots` is a real CLI flag, not a Spring property, so a second one is a usage
# error rather than an override — only default it when the caller left it out.
has_slots=0
for arg in ${serve_args[@]+"${serve_args[@]}"}; do
    case "$arg" in
        --slots|--slots=*) has_slots=1 ;;
    esac
done
if [[ $has_slots -eq 0 ]]; then
    serve_args=(--slots=1 ${serve_args[@]+"${serve_args[@]}"})
fi

mkdir -p "$(dirname "$dashboard_out")" "$(dirname "$dashboard_log")" "$(dirname "$factory_log")"

"$project_dir/gnomish" dashboard --watch --out="$dashboard_out" >"$dashboard_log" 2>&1 &
dashboard_pid=$!
logs_pid=""
http_pid=""
dashboard_url="file://$dashboard_out"

stop_pid() {
    local pid="$1"
    [[ -n "$pid" ]] || return 0
    if kill -0 "$pid" 2>/dev/null; then
        kill "$pid" 2>/dev/null || true
        wait "$pid" 2>/dev/null || true
    fi
}

cleanup() {
    stop_pid "$dashboard_pid"
    stop_pid "$logs_pid"
    stop_pid "$http_pid"
}
trap cleanup EXIT INT TERM

echo "gnomish-up: dashboard renderer pid $dashboard_pid -> $dashboard_out (log: $dashboard_log)"

if [[ $follow_logs -eq 1 ]]; then
    # -n 0: start at the end, this run's narrative only, not yesterday's.
    # -F: follow by name, so the follower survives logback rolling the file at 10MB or midnight.
    # The WARN/ERROR drop is what keeps the terminal honest: those two levels are already on
    # the daemon's own console, and printing them again would read as two separate incidents.
    # The filter is anchored on the log pattern's level field, so if that pattern ever changes
    # it stops matching and every line is passed through — noisier, never quieter.
    # The filter hangs off tail through a process substitution rather than a pipeline so that
    # $! is the tail itself: a pipeline would hand back the grep, and the tail behind it would
    # outlive this script holding the terminal open, since it only learns its reader is gone on
    # the next write — which on an idle daemon may never come. Killing the tail closes the
    # substitution, and the filter exits on EOF by itself.
    tail -n 0 -F "$factory_log" 2>/dev/null \
        > >(grep --line-buffered -Ev '\] (WARN|ERROR) +\[taskId=') &
    logs_pid=$!
    echo "gnomish-up: following $factory_log (INFO and below; WARN+ comes from the daemon itself)"
fi

# Wait for the first render before touching the browser: opening the tab on a file
# that is not there yet gives the operator a 404-ish blank page for no reason.
for _ in $(seq 1 60); do
    [[ -s "$dashboard_out" ]] && break
    kill -0 "$dashboard_pid" 2>/dev/null || break
    sleep 0.5
done

# Serves the rendered page over http and points dashboard_url at it. Every failure here is
# cosmetic — the page itself is already on disk — so each one falls back to file:// with a
# note rather than keeping the operator from their daemon.
# Ask python to bind the first free port itself and report which one it took. Probing a port
# from the shell and starting the server after it leaves a window where the port is someone
# else's by the time we look — and a port already serving something answers just as happily,
# which would put a stranger's page on camera under our own URL.
dashboard_server_py='
import functools, http.server, socket, sys
directory, ports = sys.argv[1], [int(p) for p in sys.argv[2:]]
# Threaded, and with a deadline on a connection that says nothing. A browser opens a spare
# socket next to the one it is fetching on and leaves it silent; a single-threaded server
# accepts that socket and then blocks inside it waiting for a request line that never comes,
# so every later request queues behind it and the tab spins on a blank page. It shows up
# when two factories record side by side, because that is when the browser is handed two
# tabs at once and keeps a spare connection open to one of them.
handler_class = type("DashboardHandler", (http.server.SimpleHTTPRequestHandler,), {"timeout": 30})
handler = functools.partial(handler_class, directory=directory)
refused = []
for port in ports:
    # Bind whatever localhost resolves to first — ::1 on a stock macOS — so the address bar
    # can read localhost and reach the server. Either way it is loopback: nothing published
    # here leaves this machine.
    family, _, _, _, address = socket.getaddrinfo("localhost", port, type=socket.SOCK_STREAM)[0]
    server_class = type("LoopbackServer", (http.server.ThreadingHTTPServer,), {"address_family": family})
    try:
        httpd = server_class(address[:2], handler)
    except OSError as unavailable:
        refused.append("%d: %s" % (port, unavailable))
        continue
    print(port, flush=True)
    httpd.serve_forever()
sys.exit("no port to bind (" + "; ".join(refused) + ")")
'

# Serves the rendered page over http and points dashboard_url at it. Every failure here is
# cosmetic — the page itself is already on disk — so each one falls back to file:// with a
# note rather than keeping the operator from their daemon.
start_dashboard_server() {
    local doc_root url_path port waited
    doc_root="$(dirname "$dashboard_out")"
    url_path="$(basename "$dashboard_out")"
    if [[ "$url_path" == "index.html" ]]; then
        url_path=""
    fi
    if ! command -v python3 >/dev/null 2>&1; then
        echo "gnomish-up: no python3 to serve the dashboard over http — opening the file directly" >&2
        return 1
    fi

    : >"$http_log"
    python3 -c "$dashboard_server_py" "$doc_root" \
        ${port_candidates[@]+"${port_candidates[@]}"} >"$http_log" 2>&1 &
    http_pid=$!

    port=""
    for waited in $(seq 1 40); do
        sleep 0.25
        port="$(sed -n '1{/^[0-9][0-9]*$/p;}' "$http_log" 2>/dev/null)"
        if [[ -n "$port" ]]; then
            break
        fi
        kill -0 "$http_pid" 2>/dev/null || break
    done

    if [[ -z "$port" ]]; then
        echo "gnomish-up: could not serve the dashboard over http, see $http_log — opening the file directly" >&2
        stop_pid "$http_pid"
        http_pid=""
        return 1
    fi

    dashboard_url="http://localhost:$port/$url_path"
    echo "gnomish-up: serving $doc_root at $dashboard_url (requests: $http_log)"
}

if ! kill -0 "$dashboard_pid" 2>/dev/null; then
    echo "gnomish-up: the dashboard renderer exited early, see $dashboard_log — starting the daemon anyway" >&2
elif [[ ! -s "$dashboard_out" ]]; then
    echo "gnomish-up: no page rendered within 30s, see $dashboard_log — starting the daemon anyway" >&2
else
    if [[ $demo_mode -eq 1 ]]; then
        start_dashboard_server || true
    fi
    if [[ $open_browser -eq 1 ]] && command -v open >/dev/null 2>&1; then
        open "$dashboard_url"
    fi
fi

echo "gnomish-up: starting the daemon — ./gnomish serve ${serve_args[*]}"

set +e
"$project_dir/gnomish" serve ${serve_args[@]+"${serve_args[@]}"}
serve_status=$?
set -e
exit "$serve_status"
